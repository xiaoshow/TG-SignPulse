[Unit]
Description=TG-SignPulse private Telegram check-in panel
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/tg-signpulse:local
ContainerName=tg-signpulse
PublishPort=127.0.0.1:8787:8080
Volume=/opt/tg-signpulse/data:/data:Z
Environment=TZ=Asia/Shanghai
Environment=APP_DATA_DIR=/data
Environment=APP_CORS_ALLOW_ORIGINS=http://127.0.0.1:8787,http://localhost:8787

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
